<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.weartak.plugin.permission.BIND_PLUGIN"
        android:protectionLevel="signature" />
    <permission
        android:name="com.weartak.plugin.ditto.permission.BIND_TRACKER_DITTO_V1"
        android:knownCerts="@string/tracker_release_signer_sha256"
        android:protectionLevel="signature|knownSigner" />

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <queries>
        <package android:name="com.aitech.weartak_civ" />
        <package android:name="com.tak.weartak_tracker" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="WearTAK Ditto (development)">
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <activity
            android:name=".GroupActivity"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".DittoPluginService"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="com.weartak.plugin.action.PLUGIN_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <service
            android:name=".tracker.TrackerDittoServiceV1"
            android:enabled="false"
            android:exported="false"
            android:permission="com.weartak.plugin.ditto.permission.BIND_TRACKER_DITTO_V1" />
    </application>
</manifest>
